# Alvo do proxy de desenvolvimento para /api e /sanctum (backend Laravel)
VITE_API_PROXY_TARGET=http://localhost:8000
# true = roda o painel sem backend, com MSW (mocks no navegador). Login: admin@comunika.test / qualquer senha
VITE_USE_MOCKS=false
# Rótulo do ambiente exibido no topo (vazio = produção)
VITE_APP_ENV_LABEL=HOMOLOGAÇÃO
