APP_NAME="CV Suprimentos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logs: JSON lines on stderr (ARCHITECTURE.md §10.1). Channels: json, payments, shipping, security, notifications.
LOG_CHANNEL=stack
LOG_STACK=json
LOG_JSON_STREAM=php://stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ecommerce
DB_USERNAME=ecommerce
DB_PASSWORD=secret

# Sessions / cache / queues on Redis (ADR-002). Sessions use a dedicated Redis connection ("session").
SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=cv_session
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Admin session limits (ADR-023)
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_SESSION_ABSOLUTE_MINUTES=480

CACHE_STORE=redis
CACHE_PREFIX=cv:local:
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=cv_

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# Sanctum stateful SPA (storefront :5173, admin :5174, nginx :8080)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:5174,localhost:8080,127.0.0.1,127.0.0.1:8080
# Comma separated explicit list; keep empty in production (same origin).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3 (MinIO in dev)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=ecommerce
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/ecommerce
AWS_USE_PATH_STYLE_ENDPOINT=true

# Payments (ADR-010) — never commit real secrets
PAYMENTS_DRIVER=sandbox
SANDBOX_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Shipping (SHIPPING.md §14)
# viacep (produção) | fake (dev sem rede: CEPs de Blumenau/Joinville/etc. resolvem offline)
SHIPPING_POSTAL_LOOKUP=viacep
VIACEP_BASE_URL=https://viacep.com.br/ws

# Seeds (local/testing only)
SEED_ADMIN_PASSWORD=password

SENTRY_LARAVEL_DSN=
